# Allow SpecDock's repo-local command entrypoints.
#
# This intentionally allows the entrypoint prefix instead of enumerating
# subcommands, so newly added SpecDock commands are covered automatically.
prefix_rule(
    pattern = [["./spec-dock/scripts/spec-dock", "./spec"]],
    decision = "allow",
    justification = "Allow spec-dock managed repo-local command entrypoints for SpecDock workflows.",
    match = [
        "./spec-dock/scripts/spec-dock validate",
        "./spec-dock/scripts/spec-dock sync",
        "./spec-dock/scripts/spec-dock new future-command --flag value",
        "./spec validate",
        "./spec sync",
        "./spec future-command --flag value",
    ],
    not_match = [
        "spec-dock validate",
        "uvx --from . spec-dock update .",
        "./other/scripts/spec-dock validate",
    ],
)

# Allow PR observation through fixed read-only wrappers only. Do not allow
# direct `gh api` as an agent command.
prefix_rule(
    pattern = [["./.agents/skills/github-pr-observation/scripts/wait_pr_observation.sh"]],
    decision = "allow",
    justification = "Allow fixed read-only PR observation wrappers without exposing arbitrary gh api operations.",
    match = [
        "./.agents/skills/github-pr-observation/scripts/wait_pr_observation.sh --repo owner/repo --pr 13 --head-sha abc123",
    ],
    not_match = [
        "gh api repos/owner/repo/pulls/13/comments",
        "curl https://api.github.com/repos/owner/repo/pulls/13/comments",
        "/srv/mount/.codex/skills/github-pr-observation/scripts/wait_pr_observation.sh --repo owner/repo --pr 13 --head-sha abc123",
    ],
)

prefix_rule(
    pattern = [["./.agents/skills/github-pr-observation/scripts/fetch_pr_observation_snapshot.sh"]],
    decision = "allow",
    justification = "Allow fixed read-only PR observation wrappers without exposing arbitrary gh api operations.",
    match = [
        "./.agents/skills/github-pr-observation/scripts/fetch_pr_observation_snapshot.sh --repo owner/repo --pr 13",
    ],
    not_match = [
        "gh api repos/owner/repo/pulls/13/comments",
        "curl https://api.github.com/repos/owner/repo/pulls/13/comments",
        "/srv/mount/.codex/skills/github-pr-observation/scripts/fetch_pr_observation_snapshot.sh --repo owner/repo --pr 13",
    ],
)
